from machine import Pin, SoftI2C
import time
import sh1106 as dis

#Light led D5
# D4 Red
# D3 Green

ledLight = Pin("D5",Pin.OUT)
ledRed = Pin("D4",Pin.OUT)
ledGreen = Pin("D3",Pin.OUT)

ledArray = [ledLight,ledRed,ledGreen]
ledLight.value(0)
ledRed.value(0)
ledGreen.value(0)




def menu():
  active = False
  
  print()
  print("-----------")
  print("Menu")
  print("-----------")
  print("1 | All On")
  print("2 | All Off")
