def getGyroacclReading():
  ax, ay, az, gx, gy, gz = gyroaccl.get_readings()
  return ax, ay, az, gx, gy, gz

def gyroCali():
  settlingTime = 1
  calibrationTime = 5
  offset = [0,0,0]
  numPoints = 0
  
  time.sleep(settlingTime)
  
  # Adds calibration time to current real time
  endloopTime = time.time() + calibrationTime
  
  # Starts calibration loop while the endloopTime(realtime with calibration added on) is more than current realtime
  while endloopTime > time.time():
    numPoints += 1
    (ax, ay, az, gx, gy, gz) = getGyroacclReading()
    offset[0] += gx
    offset[1] += gy
    offset[2] += gz
    
    oled.fill(0)
    # For every multiple of 100 of points done it displays progress.
    if numPoints % 100 == 0:
      print("Calibrating | {0} points done".format(numPoints))

      
      oled.text("Gyro Calibrating".format(numPoints),0,int(height/2)-4)
      oled.text("{0} points done".format(numPoints),0,int(height/2)+5)
      oled.show()
      oled.fill(0)
  
  print("Calibration complete. {0} Points".format(numPoints))
  oled.fill(0)
  oled.text("Gyro Calibrated. {0} Points".format(numPoints),0,int(height/2))
  oled.show()
  time.sleep(0.1)

  # Averages each offset using num of points done.
  offset = [i/numPoints for i in offset]
  # print("OFFSET: {0}".format(offset))
  return offset

def gyroAcclCalc(offset,initTime):
  
  # GyroAccl readings
  ax, ay, az, gx, gy, gz = gyroaccl.get_readings()
  gyro = [gx,gy,gz]
  accl = [ax,ay,az]
  pr = [0.0,0.0]

  # Adds or subtracts offset according to num sign (+ or -)
  for x in range(len(gyro)):  
    gyro[x] = round((gyro[x]-offset[x]),2)
  
  nowTime = time.ticks_us()
  deltaTime = time.ticks_diff(nowTime, initTime) / 1000000.0
  initTime = nowTime

  if deltaTime <= 0:
    return None

  acclRoll = m.degrees(m.atan2(ay, az))
  acclPitch = m.degrees(m.atan2(-ax, m.sqrt(ay*ay + az*az)))

  pr[0] = 0.995*(pr[0]+gyro[0]*deltaTime)+0.005*acclPitch # Pitch
  pr[1] = 0.995*(pr[1]+gyro[1]*deltaTime)+0.005*acclRoll # Roll
  
  

     
    
  return gyro,pr


def gyroAccl():
  offset = gyroCali()
  compass(offset)
    

def compass(offset):
  #clearing
  oled.fill(0)
  
  oversampling = 0
  sampleRate = 3
  range = 0
  
  mag.set_oversampling(oversampling)
  mag.set_samplingrate(sampleRate)
  mag.set_range(range)
  
  
  # N = D5
  # NE = D6
  # E = D7
  # SE = D8
  # S = D9
  # SW = D10
  # W = D11
  # NW = D12
  
  
  #CALIBRATION
  x_min = y_min = z_min = 32767
  x_max = y_max = z_max = -32768
  
  print("START ROTATING SENSOR IN ALL DIRECTIONS NOW...")

  oled.fill(0)
  oled.text("Calibrating...",0, 10)
  oled.text("Rotate in",0, 30)
  oled.text("all directions",0, 39)

  oled.show()
  
  time.sleep(1)

  compassCaliCycles = 10 #usually 300
  for _ in range(compassCaliCycles):
      # 1. Grab whatever data packet the library spits out
      data_packet = mag.read_raw()
      
      # 2. Check length and dynamically extract X, Y, and Z
      if len(data_packet) == 4:
          x, y, z, t = data_packet # Handles standard (x, y, z, t) tuple
      elif len(data_packet) == 3:
          x, y, z = data_packet    # Gracefully catches (x, y, z) base fallback
      else:
          continue                 # Skip loop if it returns a corrupted packet
      
      # 3. Process calibration track points normally
      x_min, x_max = min(x_min, x), max(x_max, x)
      y_min, y_max = min(y_min, y), max(y_max, y)
      z_min, z_max = min(z_min, z), max(z_max, z)
      
      time.sleep(0.03)
  
  # Calculate Offsets (Hard Iron)
  xOff = (x_max + x_min) / 2
  yOff = (y_max + y_min) / 2
  zOff = (z_max + z_min) / 2
  
  # Calculate Scales (Soft Iron)
  avg_delta = ((x_max - x_min) + (y_max - y_min) + (z_max - z_min)) / 3
  xScl = avg_delta / (x_max - x_min)
  yScl = avg_delta / (y_max - y_min)
  zScl = avg_delta / (z_max - z_min)
  
  roundPos = 2

  #------------------------#
  initTime = time.ticks_us()
  gyro = [0.0,0.0,0.0]
  
  # The damping factor (0.0 to 1.0)
  ALPHA = 0.15 # Lower values = smoother/slower data. Higher values = faster/twitchier data. 0-1
  while True:
    

    # GyroAccl readings
    ax, ay, az, gx, gy, gz = gyroaccl.get_readings()
    rawGyro = [gx,gy,gz]
    accl = [ax,ay,az]
    pr = [0.0,0.0]
  
    # Adds or subtracts offset according to num sign (+ or -)
    for x in range(len(gyro)):  
      rawGyro[x] = round((rawGyro[x]-offset[x]),2)
      gyro[x] = (ALPHA * rawGyro[x]) + ((1.0 - ALPHA) * gyro[x])
    
    nowTime = time.ticks_us()
    deltaTime = time.ticks_diff(nowTime, initTime) / 1000000.0
    initTime = nowTime
  
    if deltaTime <= 0:
      continue
  
    acclRoll = m.degrees(m.atan2(ay, az))
    acclPitch = m.degrees(m.atan2(-ax, m.sqrt(ay*ay + az*az)))
  
    pr[0] = 0.995*(pr[0]+gyro[0]*deltaTime)+0.005*acclPitch # Pitch
    pr[1] = 0.995*(pr[1]+gyro[1]*deltaTime)+0.005*acclRoll # Roll
      

    #------------------------#

    
    # Clear screen for degrees display
    oled.fill(0)
    x, y, z, t = mag.read_scaled()
    x, y, z, t = round(x, 2), round(y, 2), round(z, 2), round(t, 2)

    #raw collection
    data_packet = mag.read_raw()
  
    if len(data_packet) == 4:
        rx, ry, rz, rt = data_packet # Handles standard (x, y, z, t) tuple
    elif len(data_packet) == 3:
        rx, ry, rz = data_packet    # Gracefully catches (x, y, z) base fallback
    else:
        continue                 # Skip loop if it returns a corrupted packet
  
    #Applying calibration
    cx = (rx-xOff)*xScl
    cy = (ry-yOff)*yScl
    
    #Bearing
    bearing = round(((m.atan2((cy*-1),cx))*(180/(m.pi))),0)
    if bearing < 0:
      bearing += 360

    #Display
    oled.text(str(bearing)+" deg",0,30)
    oled.show()
    print("Compass\nx: {0}\ny: {1}\nz: {2} ".format(x, y, z))
    print(str(bearing)+"°")
    
    print("Gyro °/s\nX: {0}\nY:{1}\nZ:{2}".format(gyro[0],gyro[1],gyro[2]))
    print("PRY °\nP: {0}\nR:{1}".format(pr[0],pr[1]))

#Start button
gyroAccl()





