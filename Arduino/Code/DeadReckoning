#Compass config https://github.com/robert-hh/QMC5883
mag = qmc5883p.QMC5883P(i2c)

#GyroAccl config https://github.com/pimoroni/lsm6ds3-micropython
gyroaccl = LSM6DS3(i2c, address=106, mode=NORMAL_MODE_104HZ)

