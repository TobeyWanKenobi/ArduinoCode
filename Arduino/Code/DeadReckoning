      data_packet = mag.read_raw()
      
      # 2. Check length and dynamically extract X, Y, and Z
      if len(data_packet) == 4:
          x, y, z, t = data_packet # Handles standard (x, y, z, t) tuple
      elif len(data_packet) == 3:
          x, y, z = data_packet    # Gracefully catches (x, y, z) base fallback
      else:
          continue                 # Skip loop if it returns a corrupted packet
      
      # 3. Process calibration track points normally
      x_min, x_max = min(x_min, x), max(x_max, x)
      y_min, y_max = min(y_min, y), max(y_max, y)
      z_min, z_max = min(z_min, z), max(z_max, z)
      
      time.sleep(0.03)
  
  # Calculate Offsets (Hard Iron)
  xOff = (x_max + x_min) / 2
  yOff = (y_max + y_min) / 2
  zOff = (z_max + z_min) / 2
  
  # Calculate Scales (Soft Iron)
  avg_delta = ((x_max - x_min) + (y_max - y_min) + (z_max - z_min)) / 3
  xScl = avg_delta / (x_max - x_min)
  yScl = avg_delta / (y_max - y_min)
  zScl = avg_delta / (z_max - z_min)
  
  roundPos = 2
