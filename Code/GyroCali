def getGyroacclReading():
  ax, ay, az, gx, gy, gz = gyroaccl.get_readings()
  return ax, ay, az, gx, gy, gz

def gyroCali():
  settlingTime = 1
  calibrationTime = 5
  offset = [0,0,0]
  numPoints = 0
  
  time.sleep(settlingTime)
  
  # Adds calibration time to current real time
  endloopTime = time.time() + calibrationTime
  
  # Starts calibration loop while the endloopTime(realtime with calibration added on) is more than current realtime
  while endloopTime > time.time():
    numPoints += 1
    (ax, ay, az, gx, gy, gz) = getGyroacclReading()
    offset[0] += gx
    offset[1] += gy
    offset[2] += gz
    
    oled.fill(0)
    # For every multiple of 100 of points done it displays progress.
    if numPoints % 100 == 0:
      print("Calibrating | {0} points done".format(numPoints))

      
      oled.text("Gyro Calibrating".format(numPoints),0,int(height/2)-4)
      oled.text("{0} points done".format(numPoints),0,int(height/2)+5)
      oled.show()
      oled.fill(0)
  
  print("Calibration complete. {0} Points".format(numPoints))
  oled.fill(0)
  oled.text("Gyro Calibrated. {0} Points".format(numPoints),0,int(height/2))
  oled.show()
  time.sleep(0.1)

  # Averages each offset using num of points done.
  offset = [i/numPoints for i in offset]
  # print("OFFSET: {0}".format(offset))
  return offset

